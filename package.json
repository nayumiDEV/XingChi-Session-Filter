{
  "name": "xingchi-session-filter",
  "version": "1.0.0",
  "description": "XingChi Session Filter Proxy - Nayumi.DEV",
  "main": "server.js",
  "bin": {
    "xingchi-session-filter": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/xingchi-session-filter",
    "build:win": "pkg . --targets node18-win-x64 --output dist/xingchi-session-filter-win.exe",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/xingchi-session-filter-linux",
    "build:mac": "pkg . --targets node18-macos-x64 --output dist/xingchi-session-filter-macos"
  },
  "pkg": {
    "assets": [],
    "scripts": "server.js",
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "xingchi",
    "session",
    "filter",
    "proxy"
  ],
  "author": "Nayumi.DEV",
  "license": "MIT",
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}